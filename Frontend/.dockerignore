# Docker reads this file from the build context, which is ./Frontend
# (compose.yaml says `build: ./Frontend`), so the .dockerignore at the
# repo root does NOT apply here - this file is the one that counts.

# Built on the host for Windows - the image runs Alpine Linux and
# rebuilds them itself with `npm install`. Copying them in would
# overwrite the correct ones with binaries that cannot run.
node_modules

# Secrets. Anything prefixed VITE_ is bundled into the client, so it must
# never be baked into the image. It is mounted at runtime from the host
# instead, read-only, exactly as the backend does.
.env
.env.*

# Git metadata is useless inside the image
.git
.gitignore

# Production build output - the container runs the Vite dev server
dist
build

# Firebase Hosting deploy cache - only used on the host
.firebase

# Editor settings
.vscode

# Docker's own files
Dockerfile
.dockerignore

# Noise
*.log
npm-debug.log*
